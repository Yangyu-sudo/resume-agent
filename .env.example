# 复制为 .env 后按需修改；不配 Langfuse 也能正常跑（只是没有可观测上报）。

# ---------- 服务 ----------
PORT=5178
HOST=127.0.0.1

# ---------- DeepSeek Harness 运行时 ----------
# 默认指向本机安装的桌面版；换机器时改成实际路径，或安装 @deepseek-ai/dsh 后指向它的 bin。
# DSH_LAUNCH_COMMAND=D:\Deepseek\DeepSeek Harness.exe
# DSH_CLI_PATH=D:\Deepseek\resources\app.asar\dsh\node_modules\@deepseek-ai\dsh-desktop-host\lib\cli.js
# RESUME_DSH_PROFILE=sdk
# DSH_MODEL_PROVIDER=deepseek-official
# DSH_MODEL=deepseek-flash
# DSH_MAX_TOKENS=8192
# 用独立的 DSH_HOME 可以让 ResumeAgent 的会话与桌面版互不干扰
# RESUME_DSH_HOME=C:\Users\you\.dsh-resume

# ---------- 工作区 ----------
# 上传与产物目录，默认放在仓库下的 workspace/
# RESUME_WORKSPACE=D:\projects\resume-agent\workspace

# ---------- Langfuse ----------
# 留空即关闭上报
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
